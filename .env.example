# ---------- Backend ----------
DATABASE_URL=postgresql+psycopg://listening:listening@localhost:5432/listening_studio

# "local" writes to disk; "s3" talks to any S3-compatible store (Supabase
# Storage, Cloudflare R2, Backblaze B2, S3). Use "s3" anywhere the filesystem
# does not survive a restart, which is most free hosting.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/audio

S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Set only if the bucket serves objects publicly; leaving it blank keeps the
# bucket private and has the API serve the bytes.
S3_PUBLIC_BASE_URL=

# ---------- TTS: Kokoro (local, no API key needed) ----------
KOKORO_ENABLED=true
KOKORO_REPO_ID=hexgrad/Kokoro-82M

# espeak-ng paths.
# The dylib bundled with espeakng-loader has a build-machine path compiled in
# and cannot synthesize. Point these at a real espeak-ng install.
#   macOS:  brew install espeak-ng
#   Linux:  apt-get install espeak-ng
# Leave blank to let config.py auto-detect the usual locations.
PHONEMIZER_ESPEAK_LIBRARY=
ESPEAK_DATA_PATH=

# ---------- TTS: macOS `say` (local, macOS only) ----------
MACOS_SAY_ENABLED=true

# ---------- TTS: hosted providers (optional; blank = adapter disabled) ----------
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

ELEVENLABS_API_KEY=

# ---------- Authentication ----------
# Sign-in is delegated to Google / X, so no password is ever stored here.
# Leave both pairs blank and the app runs open, which is fine locally but
# never in production: configuring either provider turns enforcement on.
#
# Google:  https://console.cloud.google.com/apis/credentials  (free)
#   Authorised redirect URI: <backend>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# X:       https://developer.x.com/en/portal/dashboard
#   Callback URI: <backend>/api/v1/auth/x/callback
#   Note X does not release an email address at this scope.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Signs the session cookie. Generate with:  openssl rand -hex 32
# The server refuses to start in production while this is the default.
SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_COOKIE_NAME=listening_session
SESSION_MAX_AGE_SECONDS=1209600

# Where the browser is sent after signing in, and the origin allowed to send
# the session cookie.
FRONTEND_BASE_URL=http://localhost:3000

# A cross-site cookie needs both of these; they require HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
# Per-account rate limits. Rendering burns CPU, storage and egress, so it is
# capped more tightly than ordinary writes. Set either to 0 to disable it.
RATE_LIMIT_RENDERS_PER_HOUR=60
RATE_LIMIT_WRITES_PER_MINUTE=60

MAX_SCRIPT_CHARS=50000
MAX_SEGMENT_CHARS=3500
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
