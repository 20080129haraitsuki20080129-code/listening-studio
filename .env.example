# ---------- Backend ----------
DATABASE_URL=postgresql+psycopg://listening:listening@localhost:5432/listening_studio

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/audio

# ---------- TTS: Kokoro (local, no API key needed) ----------
KOKORO_ENABLED=true
KOKORO_REPO_ID=hexgrad/Kokoro-82M

# espeak-ng paths.
# The dylib bundled with espeakng-loader has a build-machine path compiled in
# and cannot synthesize. Point these at a real espeak-ng install.
#   macOS:  brew install espeak-ng
#   Linux:  apt-get install espeak-ng
# Leave blank to let config.py auto-detect the usual locations.
PHONEMIZER_ESPEAK_LIBRARY=
ESPEAK_DATA_PATH=

# ---------- TTS: macOS `say` (local, macOS only) ----------
MACOS_SAY_ENABLED=true

# ---------- TTS: hosted providers (optional; blank = adapter disabled) ----------
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

ELEVENLABS_API_KEY=

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
MAX_SCRIPT_CHARS=50000
MAX_SEGMENT_CHARS=3500
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
